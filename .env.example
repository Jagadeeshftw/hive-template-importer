# Supabase project (Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (sb_publishable_...). Safe in the browser; RLS is what protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Secret key (sb_secret_...). Server-only, bypasses RLS. Never expose it to the
# browser and never commit the real value. Used by the seed script.
SUPABASE_SECRET_KEY=sb_secret_your-key

# Database password, only needed for `supabase db push` / direct psql access.
SUPABASE_DB_PASSWORD=your-db-password

# Seeded reviewer accounts, created by the seed script via the admin API.
# Public sign-ups are disabled, so these are the only way in.
SEED_REVIEWER_1_EMAIL=reviewer1@example.com
SEED_REVIEWER_1_PASSWORD=change-me-12-chars-min
SEED_REVIEWER_2_EMAIL=reviewer2@example.com
SEED_REVIEWER_2_PASSWORD=change-me-12-chars-min
