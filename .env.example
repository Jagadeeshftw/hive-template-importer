# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose to the browser, never commit the real value.
# Used by scripts/seed.ts and by server routes that bypass RLS for seeding.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Seeded reviewer account used by scripts/seed.ts
SEED_USER_EMAIL=reviewer@example.com
SEED_USER_PASSWORD=change-me
